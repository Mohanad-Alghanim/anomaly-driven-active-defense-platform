[Unit]
Description=Anomaly-Driven Active Defense Platform background telemetry collector
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@WORKDIR@
ExecStart="@PYTHON@" -m monitor.worker --config "@CONFIG@" --data "@DATA@"
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
CPUQuota=30%
MemoryMax=384M
LimitNOFILE=512

[Install]
WantedBy=default.target
